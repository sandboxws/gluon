gluon> x := []int{1, 2, 3, 4, 5}
gluon> y := x[1:3]
gluon> :slice x, y
╭───┬───────┬───────────────┬─────┬─────╮
│   │ type  │ ptr           │ len │ cap │
├───┼───────┼───────────────┼─────┼─────┤
│ x │ []int │ 0xfab5300ce20 │ 5   │ 5   │
│ y │ []int │ 0xfab5300ce28 │ 2   │ 4   │
╰───┴───────┴───────────────┴─────┴─────╯
  x and y share a backing array — y starts 1 element into x
gluon> y = append(y, 99)
gluon> x
([]int) len=5 cap=5
╭───┬───────╮
│ # │ value │
├───┼───────┤
│ 0 │ 1     │
│ 1 │ 2     │
│ 2 │ 3     │
│ 3 │ 99    │
│ 4 │ 5     │
╰───┴───────╯
gluon> type P struct {
  ...> 	A bool
  ...> 	B int64
  ...> 	C bool
  ...> 	D string
  ...> }
gluon> :layout P
P 40 bytes, align 8
╭────────┬───────────────────┬────────┬──────╮
│ offset │ field             │ type   │ size │
├────────┼───────────────────┼────────┼──────┤
│      0 │ A                 │ bool   │    1 │
│        │ ← 7 bytes padding │        │      │
│      8 │ B                 │ int64  │    8 │
│     16 │ C                 │ bool   │    1 │
│        │ ← 7 bytes padding │        │      │
│     24 │ D                 │ string │   16 │
╰────────┴───────────────────┴────────┴──────╯
  reordering as D, B, A, C would be 32 bytes — 8 saved
