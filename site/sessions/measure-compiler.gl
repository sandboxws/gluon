func fizzbuzz(n int) string {
	var b strings.Builder
	for i := 1; i <= n; i++ {
		switch {
		case i%15 == 0:
			b.WriteString("FizzBuzz ")
		case i%5 == 0:
			b.WriteString("Buzz ")
		case i%3 == 0:
			b.WriteString("Fizz ")
		default:
			b.WriteString(strconv.Itoa(i) + " ")
		}
	}
	return b.String()
}
