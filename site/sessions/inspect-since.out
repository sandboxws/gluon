gluon> :since 1.22 -run loop-variables
go 1.22 · loop variables are per-iteration

var fs []func() int
for _, i := range []int{0, 1, 2} {
	fs = append(fs, func() int { return i })
}
[]int{fs[0](), fs[1](), fs[2]()}

