%host shop
%sh gluon init -no-prompt -write -local
%attach
:db
:query SELECT id, email, plan FROM users ORDER BY id LIMIT 5
:query SELECT plan, count(*) AS customers FROM users GROUP BY plan ORDER BY customers DESC
:query UPDATE users SET plan = 'team' WHERE id = 1
:query -w UPDATE users SET plan = 'team' WHERE id = 1
:query SELECT id, email, plan FROM users WHERE id = 1
