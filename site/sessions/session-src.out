gluon> :src
!lang go
package main

import (
	"slices"
)

func main() {
	x := []int{3, 1, 2}
	_ = x
	slices.Sort(x)
	_1 := x
	__gluonPrint(_1)
	__gluonPrint(_1[0])
}
